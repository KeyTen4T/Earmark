+/**
+ * Builds Earmark's surround-capable renderers factory when the local module is present, and the
+ * stock factory otherwise. Reflection keeps expo-audio free of any Gradle dependency on the module.
+ */
+private fun buildSurroundRenderersFactory(context: Context): androidx.media3.exoplayer.RenderersFactory {
+  return try {
+    Class.forName("app.earmark.surround.SurroundRenderersFactory")
+      .getConstructor(Context::class.java)
+      .newInstance(context) as androidx.media3.exoplayer.RenderersFactory
+  } catch (error: Throwable) {
+    androidx.media3.exoplayer.DefaultRenderersFactory(context)
+  }
+}
