{
  "name": "earmark",
  "version": "1.3.12",
  "private": true,
  "main": "index.js",
  "scripts": {
    "setup": "bash ./setup.sh",
    "android": "expo run:android",
    "start": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --import ./test/register.mjs --test test/engine.test.ts",
    "apk": "npx eas-cli build -p android --profile preview",
    "apk:local": "cd android && JAVA_HOME=$(ls -d /usr/lib/jvm/java-17-openjdk-* | head -1) ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a --max-workers=3 --no-daemon",
    "apk:emulator": "cd android && JAVA_HOME=$(ls -d /usr/lib/jvm/java-17-openjdk-* | head -1) ./gradlew assembleRelease -PreactNativeArchitectures=x86_64 --max-workers=3 --no-daemon",
    "desktop:build": "expo export --platform web --output-dir dist && rm -rf desktop/web && cp -r dist desktop/web",
    "desktop": "npm run desktop:build && npm --prefix desktop start",
    "desktop:dist": "npm run desktop:build && npm --prefix desktop run dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.2.4",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "expo": "~57.0.27",
    "expo-audio": "~57.0.5",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-intent-launcher": "~57.0.1",
    "expo-keep-awake": "57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "fflate": "^0.8.3",
    "htmlparser2": "^12.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "typescript": "~6.0.3"
  }
}
