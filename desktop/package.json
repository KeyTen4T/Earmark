{
  "name": "earmark-desktop",
  "productName": "Earmark",
  "version": "1.3.14",
  "description": "TorBox audiobook player",
  "author": "KeyTen4T <KeyTen4T@users.noreply.github.com>",
  "homepage": "https://torbox.app",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux deb AppImage"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.earmark.audiobooks",
    "files": ["main.js", "preload.js", "readalong.js", "icon.png", "web/**/*"],
    "extraResources": [
      { "from": "../tools/readalong/readalong.py", "to": "readalong/readalong.py" }
    ],
    "linux": {
      "icon": "icon.png",
      "category": "AudioVideo",
      "target": ["deb", "AppImage"],
      "maintainer": "KeyTen4T <KeyTen4T@users.noreply.github.com>",
      "synopsis": "TorBox audiobook player"
    }
  }
}
